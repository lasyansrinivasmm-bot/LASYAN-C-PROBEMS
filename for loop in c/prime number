#include <stdio.h>

int main() {
    int n, i, j, count, totalCount = 0;

    printf("enter N: ");
    scanf("%d", &n);

    for (i = 2; i <= n; i++) {
        count = 0;

        for (j = 1; j <= i; j++) {
            if (i % j == 0) {
                count++;
            }
        }

        if (count == 2) {
            totalCount++;
        }
    }

    printf("Total Prime Numbers from 1 to %d = %d", n, totalCount);

    return 0;
}
