
#include <stdio.h>

int main() {
    int num, temp, rem, sum = 0, fact, i;

    printf("Enter a number: ");
    scanf("%d", &num);

    for (temp = num; temp > 0; temp = temp / 10) {

        rem = temp % 10;  
        fact = 1;

        for (i = 1; i <= rem; i++) {
            fact = fact * i;   
        }

        sum = sum + fact;
    }

    if (sum == num)
        printf("Strong Number");
    else
        printf("Not a Strong Number");

    return 0;
}
