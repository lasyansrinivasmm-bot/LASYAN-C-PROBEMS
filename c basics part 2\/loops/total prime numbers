#include <stdio.h>

int main() {
    int n, i, j, num;
    int count = 0;
    int isPrime;

    printf("ENTER HOW MANY NUMBERS: ");
    scanf("%d", &n);

    for(i = 1; i <= n; i++) {
        printf("ENTER NUMBER %d: ", i);
        scanf("%d", &num);

        if(num <= 1) {
            continue;   
        }

        isPrime = 1;

        for(j = 2; j <= num / 2; j++) {
            if(num % j == 0) {
                isPrime = 0;   
                break;
            }
        }

        if(isPrime == 1) {
            count++;
        }
    }

    printf("TOTAL PRIME NUMBERS = %d\n", count);

    return 0;
}
