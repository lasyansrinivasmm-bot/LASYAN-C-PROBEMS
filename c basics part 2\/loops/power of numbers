#include <stdio.h>

int main() {
    int base, exponent, i;
    long long result = 1;

    printf("ENTER BASE NUMBER: ");
    scanf("%d", &base);

    printf("ENTER EXPONENT: ");
    scanf("%d", &exponent);

    for(i = 1; i <= exponent; i++) {
        result = result * base;
    }

    printf("POWER = %lld\n", result);

    return 0;
}
