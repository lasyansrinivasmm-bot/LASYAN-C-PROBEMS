#include <stdio.h>

int main() {
    int number;

    printf("Enter a positive integer: ");
    scanf("%d", &number);

    while (number <= 0) {
        printf("Invalid input! Please try again.\n");
        printf("Enter a positive integer: ");
        scanf("%d", &number);
    }

    printf("Thank you! You entered: %d\n", number);

    return 0;
}
