#include <stdio.h>

int main() {
    int start = 10, end = 50, i, j, isPrime;

    i = start;
    while (i <= end) {
        isPrime = 1;
        j = 2;

        while (j <= i / 2) {
            if (i % j == 0) {
                isPrime = 0;
                break;
            }
            j++;
        }

        if (isPrime && i > 1) {
            printf("%d ", i);
        }

        i++;
    }
    return 0;
}
