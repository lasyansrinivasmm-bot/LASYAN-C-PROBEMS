#include <stdio.h>

int main()
{
    int totalData, N;
    int usage;
    int i = 0;
    int days = 0;

    scanf("%d", &totalData);
    scanf("%d", &N);

    while (i < N)
    {
        scanf("%d", &usage);

        if (totalData >= usage)
        {
            totalData = totalData - usage;
            days++;
        }
        else
        {
            break;
        }

        i++;
    }

    printf("Days Data Lasted: %d\n", days);
    printf("Remaining Data: %d\n", totalData);

    return 0;
}
