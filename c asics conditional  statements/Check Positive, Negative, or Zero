#include <stdio.h>

int main() {
    // Declare a variable to store the user input
    int number;

  
    printf("Enter a number: ");

 
    scanf("%d", &number);

 
    if (number > 0) {
        printf("Output: Positive number\n");
        printf("Explanation: The number is greater than 0.\n");
    } else if (number < 0) {
        printf("Output: Negative number\n");
        printf("Explanation: The number is less than 0.\n");
    } else {
        printf("Output: Zero\n");
        printf("Explanation: The number is equal to 0.\n");
    }

    return 0;
}
